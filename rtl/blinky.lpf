# MachXO2-4000HC-4TG144C minimal board - Lattice Diamond constraints
BLOCK RESETPATHS;
BLOCK ASYNCPATHS;
SYSCONFIG JTAG_PORT=ENABLE PROGRAMN_PORT=ENABLE INITN_PORT=ENABLE DONE_PORT=ENABLE;

LOCATE COMP "clk12" SITE "128";
IOBUF PORT "clk12" IO_TYPE=LVCMOS33;
FREQUENCY PORT "clk12" 12.0 MHz;

LOCATE COMP "btn0" SITE "96";
IOBUF PORT "btn0" IO_TYPE=LVCMOS33 PULLMODE=UP;

LOCATE COMP "led[0]" SITE "97";
IOBUF PORT "led[0]" IO_TYPE=LVCMOS33;
LOCATE COMP "led[1]" SITE "98";
IOBUF PORT "led[1]" IO_TYPE=LVCMOS33;
LOCATE COMP "led[2]" SITE "99";
IOBUF PORT "led[2]" IO_TYPE=LVCMOS33;
LOCATE COMP "led[3]" SITE "100";
IOBUF PORT "led[3]" IO_TYPE=LVCMOS33;

# UART header J3 (uncomment when used)
# LOCATE COMP "uart_tx" SITE "111";
# LOCATE COMP "uart_rx" SITE "112";

# GPIO header map (net IO_<pin> = package pin)
#   GPIO_A (J4): 3->1 4->2 5->3 6->4 7->5 8->6 9->9 10->10 11->11 12->12 13->13 14->14 15->15 16->17 17->19 18->20 19->21 20->22 21->23 22->24 23->25 24->26 25->27 26->28 27->31 28->32 29->33 30->34 31->35 32->38 33->39 34->40 35->41 36->42 37->43 38->44
#   GPIO_B (J5): 3->45 4->47 5->48 6->49 7->50 8->52 9->54 10->55 11->56 12->57 13->58 14->59 15->60 16->61 17->62 18->63 19->65 20->67 21->68 22->69 23->70 24->71 25->73 26->74 27->75 28->76 29->77 30->78 31->81 32->82 33->83 34->84 35->85 36->86 37->87 38->89
